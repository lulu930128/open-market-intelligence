# App
APP_NAME=Open Market Intelligence
APP_ENV=development
APP_HOST=127.0.0.1
# Preferred backend/frontend ports. The launcher will auto-select the next
# bindable port when a preferred port is occupied or Windows-reserved.
APP_PORT=8400
OMI_FRONTEND_HOST=127.0.0.1
OMI_FRONTEND_PORT=3000

# Database
# Leave DATABASE_URL unset to use data/open_market_intelligence.db under the project root.
# DATABASE_URL=sqlite:///C:/Open Market Intelligence/data/open_market_intelligence.db
# Cross-process schema/background locks. Override for isolated parallel runtimes.
# RUNTIME_LOCK_DIR=C:/Open Market Intelligence/data/.runtime
RUNTIME_SCHEMA_LOCK_TIMEOUT_SECONDS=60
# Empty installations enqueue one bounded TWSE/TPEx symbol bootstrap job.
ENABLE_STOCK_MASTER_BOOTSTRAP=true

# Technical analysis defaults
TECHNICAL_MA_WINDOWS=5,20,60
TECHNICAL_VOLUME_MA_WINDOWS=5,20
TECHNICAL_MACD_FAST_PERIOD=12
TECHNICAL_MACD_SLOW_PERIOD=26
TECHNICAL_MACD_SIGNAL_PERIOD=9
TECHNICAL_PVO_FAST_PERIOD=12
TECHNICAL_PVO_SLOW_PERIOD=26
TECHNICAL_PVO_SIGNAL_PERIOD=9
TECHNICAL_RSI_PERIOD=14
TECHNICAL_ATR_PERIOD=14
TECHNICAL_ADX_PERIOD=14
TECHNICAL_ROC_PERIOD=12
TECHNICAL_MFI_PERIOD=14
TECHNICAL_DONCHIAN_PERIOD=20
TECHNICAL_BOLLINGER_PERIOD=20
TECHNICAL_BOLLINGER_STD_DEV=2.0
TECHNICAL_KD_PERIOD=9
TECHNICAL_KD_SMOOTH_PERIOD=3
TECHNICAL_KD_OVERBOUGHT_K=80.0
TECHNICAL_KD_OVERBOUGHT_D=70.0
TECHNICAL_KD_OVERSOLD_K=20.0
TECHNICAL_KD_OVERSOLD_D=30.0
TECHNICAL_SUPPORT_RESISTANCE_PERIOD=20
TECHNICAL_MAX_GAP_DAYS=10
TECHNICAL_VOLUME_RATIO_THRESHOLD=1.5
TECHNICAL_BREAKOUT_VOLUME_RATIO_THRESHOLD=1.2
TECHNICAL_NEAR_LEVEL_THRESHOLD_PCT=2.0
TECHNICAL_ADX_TREND_THRESHOLD=25.0
TECHNICAL_RSI_BULL_MIN=50.0
TECHNICAL_RSI_BULL_MAX=70.0
TECHNICAL_RSI_WEAK_BELOW=40.0
TECHNICAL_RSI_OVERHEATED_AT=80.0
TECHNICAL_MFI_INFLOW_MIN=50.0
TECHNICAL_MFI_INFLOW_MAX=80.0
TECHNICAL_MFI_OUTFLOW_BELOW=35.0
TECHNICAL_ATR_HIGH_VOLATILITY_PCT=5.0
TECHNICAL_ATR_EXPANSION_MULTIPLIER=1.2
TECHNICAL_ATR_EXPANSION_MIN_PCT=2.0
TECHNICAL_BOLLINGER_SQUEEZE_BANDWIDTH_PCT=8.0

# Optional API tokens
FINMIND_TOKEN=
ALPHAVANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
OPENFIGI_API_KEY=
FRED_API_KEY=
# Taiwan futures live quote provider. Keep taifex_mis until a broker adapter is wired.
TAIWAN_FUTURES_QUOTE_PROVIDER=taifex_mis
# Reserved KGI API slot for future account/trading integration.
# The KGI SuperPy adapter below does not use these legacy fields.
KGI_API_KEY=
KGI_API_SECRET=
KGI_ACCOUNT=
KGI_CERT_PATH=
KGI_API_BASE_URL=

# KGI SuperPy quote and read-only portfolio source. Keep real credentials in
# the repo-root .env; never copy them into this tracked example or frontend env.
ENABLE_KGI_SUPERPY_QUOTE=false
CANONICAL_MARKET_DATA_MODE=off
US_CANONICAL_MARKET_DATA_MODE=
# US staged rollout: off -> shadow -> compare -> canary -> on. Shadow/compare are
# dark; canary exposes matched canonical evidence only for this bounded list;
# on applies the same parity gate to requested US symbols. Default stays off.
US_CANONICAL_SHADOW_SYMBOLS=
US_CANONICAL_CANARY_MAX_SYMBOLS=5
KGI_SUPERPY_PERSON_ID=
KGI_SUPERPY_PASSWORD=
KGI_SUPERPY_SIMULATION=false
# Optional account selectors. Leave blank when there is exactly one matching
# securities / sub-brokerage account. Required only when login returns more
# than one account of the corresponding type.
KGI_SUPERPY_TW_ACCOUNT=
KGI_SUPERPY_US_ACCOUNT=
# Optional isolated interpreter override. Must be a 64-bit Python 3.12 runtime;
# setup-kgi-superpy.ps1 creates the default .venv-kgi/Scripts/python.exe.
# KGI_SUPERPY_PYTHON=C:/project/Open Market Intelligence/.venv-kgi/Scripts/python.exe
KGI_SUPERPY_QUOTE_STALE_SECONDS=180
KGI_SUPERPY_LEASE_TTL_SECONDS=60
KGI_SUPERPY_IDLE_SHUTDOWN_SECONDS=120
KGI_SUPERPY_START_TIMEOUT_SECONDS=30
KGI_SUPERPY_COMMAND_TIMEOUT_SECONDS=45
# Fugle Basic is a bounded realtime resilience lane: one physical WebSocket,
# at most five subscriptions, TAIEX plus one active TWSE stock. Keep disabled
# until an API key and live-session acceptance are available.
ENABLE_FUGLE_REALTIME=false
FUGLE_API_KEY=
FUGLE_ACTIVE_STOCK=
FUGLE_STREAM_STALE_SECONDS=75
FUGLE_MATERIALIZE_INTERVAL_SECONDS=5
FUGLE_RECONNECT_MAX_SECONDS=30
# SEC asks automated clients to send a descriptive User-Agent. Prefer app/contact info.
US_SEC_USER_AGENT=Open Market Intelligence local research; contact=you@example.com
US_MARKET_HTTP_TIMEOUT_SECONDS=30
JP_MARKET_HTTP_TIMEOUT_SECONDS=30
KR_MARKET_HTTP_TIMEOUT_SECONDS=30
# Japan fundamentals use J-Quants v2 summary. Prefer JQUANTS_API_KEY for local runs.
JQUANTS_API_BASE_URL=https://api.jquants.com/v2
JQUANTS_API_KEY=
# Legacy v1 token flow fallback. J-Quants v1 has been migrated to v2.
JQUANTS_ID_TOKEN=
JQUANTS_REFRESH_TOKEN=
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=
JQUANTS_ID_TOKEN_CACHE_SECONDS=82800
# Korea fundamentals use OpenDART. Leave key empty to skip KR fundamentals refresh visibly.
OPENDART_API_BASE_URL=https://opendart.fss.or.kr/api
OPENDART_API_KEY=
# Keep false for local desktop/dev runs unless a real outbound proxy is required.
OMI_HTTP_TRUST_ENV=false
# Local read-only Atlas shadow context. Atlas owns provider refresh, event identity,
# attribution, deduplication, coverage, and freshness; OMI only reads its cache.
OMI_ATLAS_SHADOW_ENABLED=false
OMI_ATLAS_API_BASE_URL=http://127.0.0.1:8790
OMI_ATLAS_TIMEOUT_SECONDS=1.5
OMI_ATLAS_MAX_EVENTS=5
OMI_ATLAS_MAX_EVIDENCE_PER_EVENT=3
OMI_ATLAS_LOOKBACK_HOURS=168
OPENAI_API_KEY=
# Optional alias used by the desktop pet launcher. OMI uses it only if OPENAI_API_KEY is empty.
OPENAI_LLM_API_KEY=
# Optional external env file to read OPENAI_API_KEY / OPENAI_LLM_API_KEY from at runtime.
# OMI_OPENAI_ENV_FILE=C:/project/kuro/.env
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=1800
OMI_AI_ALLOW_LOCAL_TRUST=true
OMI_AI_TRUSTED_CLIENT_HOSTS=127.0.0.1,::1
# Optional token for trusted non-loopback AI report/debug tool access.
OMI_AI_TRUST_TOKEN=

# Scheduler
ENABLE_SCHEDULER=false
# Independent bounded refresh for TWSE/NYSE/JPX/KRX official holiday calendars.
ENABLE_MARKET_CALENDAR_SCHEDULER=true
SCHEDULER_MARKET_CALENDAR_REFRESH_TIME=07:15
MARKET_CALENDAR_HTTP_TIMEOUT_SECONDS=20
# Independent bounded refresh for TWSE/TPEx official disposition securities.
ENABLE_TW_DISPOSITION_SCHEDULER=true
SCHEDULER_TW_DISPOSITION_REFRESH_TIME=07:20
TW_DISPOSITION_HTTP_TIMEOUT_SECONDS=20
TW_DISPOSITION_CACHE_STALE_HOURS=96
# Optional local cache path. Defaults to data/tw_dispositions.json.
# TW_DISPOSITION_CACHE_PATH=C:/project/Open Market Intelligence/data/tw_dispositions.json
# Official TWSE/TPEx ex-dividend notices and MOPS investor/financial-result events.
# The bounded MOPS refresh covers listed/OTC companies for the current and next month.
ENABLE_TW_CORPORATE_EVENT_SCHEDULER=true
SCHEDULER_TW_CORPORATE_EVENT_REFRESH_TIME=07:25
TW_CORPORATE_EVENT_HTTP_TIMEOUT_SECONDS=20
# Bounded attempts per MOPS market/month window (1-3). Only transport failures retry.
TW_CORPORATE_EVENT_MOPS_MAX_ATTEMPTS=2
TW_CORPORATE_EVENT_CACHE_STALE_HOURS=48
TW_CORPORATE_EVENT_LOOKAHEAD_MONTHS=2
TW_CORPORATE_EVENT_REMINDER_DAYS=7
TW_CORPORATE_EVENT_HISTORY_YEARS=5
TW_CORPORATE_EVENT_HISTORY_REFRESH_DAYS=7
SCHEDULER_TW_CORPORATE_EVENT_HISTORY_REFRESH_TIME=07:35
SCHEDULER_TW_CORPORATE_EVENT_HISTORY_REFRESH_DAY_OF_WEEK=sun
# Optional local cache path. Defaults to data/tw_corporate_events.json.
# TW_CORPORATE_EVENT_CACHE_PATH=C:/project/Open Market Intelligence/data/tw_corporate_events.json
# Daily TWSE/TPEx ordinary-stock broker-branch Top15 collection.
# This is independent from ENABLE_SCHEDULER and stores one latest snapshot per stock/date.
ENABLE_TW_BROKER_BRANCH_SCHEDULER=true
# nStock does not publish a contractual release minute. OMI uses a conservative
# 16:00 availability window and starts collection five minutes later.
SCHEDULER_TW_BROKER_BRANCH_REFRESH_TIME=16:05
SCHEDULER_TW_BROKER_BRANCH_REFRESH_DAY_OF_WEEK=mon-fri
SCHEDULER_TW_BROKER_BRANCH_SLEEP_SECONDS=0.5
SCHEDULER_TW_BROKER_BRANCH_MAX_STOCKS=2500
SCHEDULER_TW_BROKER_BRANCH_MAX_RUNTIME_SECONDS=7200
SCHEDULER_TW_BROKER_BRANCH_RECONCILE_INTERVAL_MINUTES=30
SCHEDULER_TW_BROKER_BRANCH_RECONCILE_UNTIL=20:00
# Shadow-only derived behavior features. Disabled until the local schema has
# migration 0066 and the bounded benchmark/runtime acceptance gates pass.
ENABLE_TW_BROKER_BRANCH_BEHAVIOR_SHADOW_SCHEDULER=false
SCHEDULER_TW_BROKER_BRANCH_BEHAVIOR_SHADOW_TIME=20:15
SCHEDULER_TW_BROKER_BRANCH_BEHAVIOR_LOOKBACK_SESSIONS=120
# Independent automatic refresh for stock-detail chips, institutional, revenue,
# and earnings tabs. Times are Asia/Taipei and intentionally do not enable the
# broader ENABLE_SCHEDULER surface.
ENABLE_TW_STOCK_DETAIL_SCHEDULER=true
# TWSE complete institutional file (including block trades) is produced around
# 20:00; the first provider request is five minutes later.
SCHEDULER_TW_INSTITUTIONAL_REFRESH_TIME=20:05
# TWSE margin balance file is produced around 21:00.
SCHEDULER_TW_MARGIN_REFRESH_TIME=21:05
# TDCC does not publish an exact minute. OMI assumes Saturday 12:00 and performs
# bounded hourly reconciliation from 12:05 through 18:05.
SCHEDULER_TW_SHAREHOLDING_REFRESH_TIME=12:05
# MOPS submissions are issuer-driven. OMI reconciles after the filing deadline
# at 00:05 and retries only during the bounded 00:05-03:05 window.
SCHEDULER_TW_REVENUE_REFRESH_TIME=00:05
SCHEDULER_TW_FINANCIAL_REFRESH_TIME=00:05
MARKET_CALENDAR_CACHE_STALE_DAYS=14
# MARKET_CALENDAR_CACHE_PATH=C:/path/to/market_calendars.json
TIMEZONE=Asia/Taipei
SCHEDULER_MARKET_REFRESH_TIME=20:05
SCHEDULER_MARKET_REFRESH_LOOKBACK_DAYS=7
SCHEDULER_MARKET_REFRESH_SLEEP_SECONDS=0.2
SCHEDULER_MARKET_CHIP_REFRESH_TIME=15:10
SCHEDULER_MARKET_CHIP_REFRESH_RETRY_DELAY_MINUTES=30
SCHEDULER_MARKET_CHIP_MARGIN_REFRESH_TIME=21:10
# Independent from ENABLE_SCHEDULER so late margin data is not missed.
ENABLE_MARKET_CHIP_MARGIN_SCHEDULER=true
SCHEDULER_MARKET_MARGIN_REFRESH_TIME=21:05
SCHEDULER_MARKET_CHIP_REFRESH_INDEX_IDS=TAIEX,TPEX
SCHEDULER_MARKET_CHIP_REFRESH_FORCE=false
# Current-session TAIEX/TPEX snapshots stay lightweight at five seconds. Full
# registered-universe MIS breadth has a separate bounded lane so rate limiting
# or batch latency cannot block index persistence.
ENABLE_TAIWAN_MARKET_INDEX_SCHEDULER=true
SCHEDULER_TAIWAN_MARKET_INDEX_INTERVAL_SECONDS=5
ENABLE_TAIWAN_MARKET_BREADTH_SCHEDULER=true
SCHEDULER_TAIWAN_MARKET_BREADTH_INTERVAL_SECONDS=60
# Fixed-slot quote evidence for contract acceptance and replay. Keep the symbol
# set bounded; leave it empty to use enabled Taiwan watchlist items.
ENABLE_TAIWAN_QUOTE_CONTRACT_SCHEDULER=true
SCHEDULER_TAIWAN_QUOTE_CONTRACT_SYMBOLS=2330
SCHEDULER_TAIWAN_QUOTE_CONTRACT_MAX_SYMBOLS=3
ENABLE_TAIWAN_INTRADAY_BAR_SCHEDULER=true
SCHEDULER_TAIWAN_INTRADAY_BAR_INTERVAL_SECONDS=300
SCHEDULER_TAIWAN_INTRADAY_BAR_MAX_SYMBOLS=3
# Persist source-health snapshots outside GET/read paths.
ENABLE_TAIWAN_SOURCE_HEALTH_SCHEDULER=true
SCHEDULER_TAIWAN_SOURCE_HEALTH_INTERVAL_SECONDS=120
# Independent lightweight collector. Polls only during Taiwan futures live sessions.
ENABLE_TAIWAN_FUTURES_SCHEDULER=true
SCHEDULER_TAIWAN_FUTURES_SYMBOLS=TXF,MXF,TMF
SCHEDULER_TAIWAN_FUTURES_SESSION=auto
SCHEDULER_TAIWAN_FUTURES_INTERVAL_SECONDS=30
SCHEDULER_TAIWAN_FUTURES_SUCCESS_EVENT_INTERVAL_SECONDS=300
# Independent daily post-close TAIFEX refresh. Five official requests at most per run.
ENABLE_TAIWAN_DERIVATIVES_SCHEDULER=true
SCHEDULER_TAIWAN_DERIVATIVES_REFRESH_TIME=16:20
SCHEDULER_TAIWAN_DERIVATIVES_REFRESH_DAY_OF_WEEK=mon-fri
SCHEDULER_TAIWAN_DERIVATIVES_SUCCESS_COOLDOWN_SECONDS=43200
ENABLE_US_MARKET_SCHEDULER=false
# Default assumes Asia/Taipei: run Tue-Sat morning after US regular sessions close.
SCHEDULER_US_MARKET_REFRESH_TIME=06:30
SCHEDULER_US_MARKET_REFRESH_DAY_OF_WEEK=tue-sat
SCHEDULER_US_MARKET_REFRESH_OUTPUTSIZE=compact
SCHEDULER_US_MARKET_REFRESH_ADJUSTED=false
SCHEDULER_US_MARKET_REFRESH_SLEEP_SECONDS=12.0

# Feature-off bounded owner for persisted US Quote / Intraday evidence.
# It runs only when both ENABLE_SCHEDULER and this flag are true; GET remains cache-only.
ENABLE_US_INTRADAY_MATERIALIZER=false
SCHEDULER_US_INTRADAY_MATERIALIZER_SYMBOLS=AAPL,TSM
SCHEDULER_US_INTRADAY_MATERIALIZER_MAX_SYMBOLS=2
SCHEDULER_US_QUOTE_MATERIALIZER_INTERVAL_SECONDS=60
SCHEDULER_US_INTRADAY_MATERIALIZER_INTERVAL_SECONDS=60
SCHEDULER_US_INTRADAY_MATERIALIZER_BARS=600
SCHEDULER_US_INTRADAY_MATERIALIZER_MAX_PROVIDER_CALLS=2
SCHEDULER_US_INTRADAY_MATERIALIZER_MAX_EXTERNAL_CALLS=4
ENABLE_US_INDEX_QUOTE_MATERIALIZER=false
ENABLE_US_INDEX_INTRADAY_MATERIALIZER=false
SCHEDULER_US_INDEX_QUOTE_SYMBOLS=^GSPC,^DJI,^IXIC,^SOX,^NDX,^VIX
SCHEDULER_US_INDEX_QUOTE_MAX_SYMBOLS=6
SCHEDULER_US_INDEX_QUOTE_MAX_EXTERNAL_CALLS=6
ENABLE_US_QUOTE_RETENTION_SCHEDULER=false
US_QUOTE_SNAPSHOT_RETENTION_DAYS=30
SCHEDULER_US_QUOTE_CLEANUP_MAX_ROWS=10000

# Bounded Priority EOD lane for indices, active US holdings, and enabled US
# watchlist symbols. Critical indices/holdings are checked every run; remaining
# watchlist symbols rotate behind a durable cursor. Repair stays inside the
# canonical USDailyOhlcvPlatform and the explicit per-run call budgets below.
ENABLE_US_PRIORITY_OHLC_SCHEDULER=true
SCHEDULER_US_PRIORITY_OHLC_INTERVAL_MINUTES=30
SCHEDULER_US_PRIORITY_OHLC_STARTUP_DELAY_SECONDS=0
SCHEDULER_US_PRIORITY_OHLC_MAX_RUNTIME_SECONDS=600
SCHEDULER_US_PRIORITY_OHLC_MAX_SYMBOLS=20
SCHEDULER_US_PRIORITY_OHLC_MAX_EXTERNAL_CALLS=20
SCHEDULER_US_PRIORITY_OHLC_MAX_PROVIDER_ATTEMPTS=2

# Independent bounded Control-Plane gate. Cache-only audits never acquire or
# write. Missing canonical index Daily/Quote data may enqueue at most one
# tracked repair per completed-session target, subject to cooldown and budgets.
ENABLE_US_INDEX_DATA_REPAIR_GATE=true
SCHEDULER_US_INDEX_DATA_REPAIR_INTERVAL_MINUTES=30
SCHEDULER_US_INDEX_DATA_REPAIR_STARTUP_DELAY_SECONDS=30
SCHEDULER_US_INDEX_DATA_REPAIR_COOLDOWN_SECONDS=1800
SCHEDULER_US_INDEX_DATA_REPAIR_MAX_ATTEMPTS=2
SCHEDULER_US_INDEX_DATA_REPAIR_MANUAL_ATTENTION_BACKOFF_SECONDS=21600
SCHEDULER_US_INDEX_DATA_REPAIR_MAX_RUNTIME_SECONDS=600
SCHEDULER_US_INDEX_DATA_REPAIR_DAILY_MAX_EXTERNAL_CALLS=12
SCHEDULER_US_INDEX_DATA_REPAIR_QUOTE_MAX_EXTERNAL_CALLS=12

# Durable full-market completed-session EOD coverage. This scheduler is
# independent of ENABLE_SCHEDULER so startup catch-up does not depend on a UI
# visit. US repair is bounded and resumable because the current free provider
# is per-symbol; it never uses Alpha Vantage quota.
ENABLE_EOD_COVERAGE_SCHEDULER=true
SCHEDULER_EOD_COVERAGE_MARKETS=TW,US
SCHEDULER_EOD_COVERAGE_INTERVAL_MINUTES=30
SCHEDULER_EOD_COVERAGE_US_MAX_SYMBOLS_PER_RUN=250
SCHEDULER_EOD_COVERAGE_US_MAX_RUNTIME_SECONDS=600
SCHEDULER_EOD_COVERAGE_US_SLEEP_SECONDS=1.0
SCHEDULER_EOD_COVERAGE_US_MAX_CONSECUTIVE_ERRORS=5
SCHEDULER_EOD_COVERAGE_ERROR_BACKOFF_SECONDS=1800
# One bounded Alpha Vantage EARNINGS_CALENDAR request per interval.
ENABLE_US_CORPORATE_EVENT_SCHEDULER=true
SCHEDULER_US_CORPORATE_EVENT_REFRESH_HOURS=3
US_CORPORATE_EVENT_HTTP_TIMEOUT_SECONDS=20
US_CORPORATE_EVENT_CACHE_STALE_HOURS=6
US_CORPORATE_EVENT_REMINDER_DAYS=7
ENABLE_JP_MARKET_SCHEDULER=false
# Requires ENABLE_SCHEDULER=true. Default assumes Asia/Taipei: run after Japan regular session data is typically available.
SCHEDULER_JP_MARKET_REFRESH_TIME=16:10
SCHEDULER_JP_MARKET_REFRESH_DAY_OF_WEEK=mon-fri
SCHEDULER_JP_MARKET_REFRESH_OUTPUTSIZE=compact
SCHEDULER_JP_MARKET_REFRESH_PROVIDER=auto
SCHEDULER_JP_MARKET_REFRESH_INCLUDE_FUNDAMENTALS=true
SCHEDULER_JP_MARKET_REFRESH_SLEEP_SECONDS=15.0
ENABLE_KR_MARKET_SCHEDULER=false
# Requires ENABLE_SCHEDULER=true. Default assumes Asia/Taipei: run after Korea regular session data is typically available.
SCHEDULER_KR_MARKET_REFRESH_TIME=16:20
SCHEDULER_KR_MARKET_REFRESH_DAY_OF_WEEK=mon-fri
SCHEDULER_KR_MARKET_REFRESH_OUTPUTSIZE=compact
SCHEDULER_KR_MARKET_REFRESH_PROVIDER=auto
SCHEDULER_KR_MARKET_REFRESH_INCLUDE_FUNDAMENTALS=false
SCHEDULER_KR_MARKET_REFRESH_SLEEP_SECONDS=15.0
ENABLE_WATCHLIST_RADAR_SCHEDULER=true
# Daily radar snapshot and T+1 outcome evaluation. Empty group ids means all active watchlist groups.
SCHEDULER_WATCHLIST_RADAR_TIME=15:45
SCHEDULER_WATCHLIST_RADAR_DAY_OF_WEEK=mon-fri
SCHEDULER_WATCHLIST_RADAR_GROUP_IDS=
SCHEDULER_WATCHLIST_RADAR_MODES=action
SCHEDULER_WATCHLIST_RADAR_INCLUDE_CHILDREN=true
SCHEDULER_WATCHLIST_RADAR_ENABLED_ONLY=true
SCHEDULER_WATCHLIST_RADAR_MAX_RESULTS=30
SCHEDULER_WATCHLIST_RADAR_CALCULATION_LIMIT=100
SCHEDULER_WATCHLIST_RADAR_USE_INTRADAY=true
SCHEDULER_WATCHLIST_RADAR_INTRADAY_LIMIT=30
SCHEDULER_WATCHLIST_RADAR_EVALUATE_LOOKBACK_DAYS=10
SCHEDULER_WATCHLIST_RADAR_REQUIRE_DAILY_RELEASE=true
SCHEDULER_WATCHLIST_RADAR_RECONCILE_INTERVAL_MINUTES=30
SCHEDULER_WATCHLIST_RADAR_RECONCILE_UNTIL=18:15
ENABLE_DISPATCH_SCHEDULER=true
DISPATCH_SCHEDULER_V2_ENABLED=true
SCHEDULER_DISPATCH_TICK_INTERVAL_SECONDS=60
SCHEDULER_DISPATCH_CLAIM_LIMIT=100
SCHEDULER_DISPATCH_RECONCILE_INTERVAL_SECONDS=300
SCHEDULER_DISPATCH_STALE_CLAIM_MINUTES=5
SCHEDULER_DISPATCH_DEFAULT_MISFIRE_GRACE_MINUTES=15
SCHEDULER_DISPATCH_DEFAULT_RETRY_INTERVAL_SECONDS=300
SCHEDULER_DISPATCH_DEFAULT_MAX_RETRIES=2
SCHEDULER_DISPATCH_DEFAULT_READINESS_DEADLINE_MINUTES=60

# Optional SMTP settings for Dispatch. Use app passwords or provider-specific
# SMTP credentials; never commit real credentials.
DISPATCH_SMTP_HOST=
DISPATCH_SMTP_PORT=587
DISPATCH_SMTP_USERNAME=
DISPATCH_SMTP_PASSWORD=
DISPATCH_SMTP_FROM_EMAIL=
DISPATCH_SMTP_FROM_NAME=Open Market Intelligence
DISPATCH_SMTP_USE_TLS=true
DISPATCH_SMTP_USE_SSL=false
DISPATCH_SMTP_TIMEOUT_SECONDS=30
