# App
APP_NAME=Open Market Intelligence
APP_ENV=development
APP_HOST=127.0.0.1
# Preferred backend/frontend ports. The launcher will auto-select the next
# bindable port when a preferred port is occupied or Windows-reserved.
APP_PORT=8400
OMI_FRONTEND_HOST=127.0.0.1
OMI_FRONTEND_PORT=3000

# Database
# Leave DATABASE_URL unset to use data/open_market_intelligence.db under the project root.
# DATABASE_URL=sqlite:///C:/Open Market Intelligence/data/open_market_intelligence.db
# Cross-process schema/background locks. Override for isolated parallel runtimes.
# RUNTIME_LOCK_DIR=C:/Open Market Intelligence/data/.runtime
RUNTIME_SCHEMA_LOCK_TIMEOUT_SECONDS=60

# Technical analysis defaults
TECHNICAL_MA_WINDOWS=5,20,60
TECHNICAL_VOLUME_MA_WINDOWS=5,20
TECHNICAL_MACD_FAST_PERIOD=12
TECHNICAL_MACD_SLOW_PERIOD=26
TECHNICAL_MACD_SIGNAL_PERIOD=9
TECHNICAL_RSI_PERIOD=14
TECHNICAL_ATR_PERIOD=14
TECHNICAL_ADX_PERIOD=14
TECHNICAL_ROC_PERIOD=12
TECHNICAL_MFI_PERIOD=14
TECHNICAL_DONCHIAN_PERIOD=20
TECHNICAL_BOLLINGER_PERIOD=20
TECHNICAL_BOLLINGER_STD_DEV=2.0
TECHNICAL_KD_PERIOD=9
TECHNICAL_KD_SMOOTH_PERIOD=3
TECHNICAL_KD_OVERBOUGHT_K=80.0
TECHNICAL_KD_OVERBOUGHT_D=70.0
TECHNICAL_KD_OVERSOLD_K=20.0
TECHNICAL_KD_OVERSOLD_D=30.0
TECHNICAL_SUPPORT_RESISTANCE_PERIOD=20
TECHNICAL_MAX_GAP_DAYS=10
TECHNICAL_VOLUME_RATIO_THRESHOLD=1.5
TECHNICAL_NEAR_LEVEL_THRESHOLD_PCT=2.0
TECHNICAL_ADX_TREND_THRESHOLD=25.0
TECHNICAL_RSI_BULL_MIN=50.0
TECHNICAL_RSI_BULL_MAX=70.0
TECHNICAL_RSI_WEAK_BELOW=40.0
TECHNICAL_RSI_OVERHEATED_AT=80.0
TECHNICAL_MFI_INFLOW_MIN=50.0
TECHNICAL_MFI_INFLOW_MAX=80.0
TECHNICAL_MFI_OUTFLOW_BELOW=35.0
TECHNICAL_ATR_HIGH_VOLATILITY_PCT=5.0
TECHNICAL_ATR_EXPANSION_MULTIPLIER=1.2
TECHNICAL_ATR_EXPANSION_MIN_PCT=2.0
TECHNICAL_BOLLINGER_SQUEEZE_BANDWIDTH_PCT=8.0

# Optional API tokens
FINMIND_TOKEN=
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
# Taiwan futures live quote provider. Keep taifex_mis until a broker adapter is wired.
TAIWAN_FUTURES_QUOTE_PROVIDER=taifex_mis
# Optional KGI API slot. Leave empty until the KGI adapter is implemented.
KGI_API_KEY=
KGI_API_SECRET=
KGI_ACCOUNT=
KGI_CERT_PATH=
KGI_API_BASE_URL=
# SEC asks automated clients to send a descriptive User-Agent. Prefer app/contact info.
US_SEC_USER_AGENT=Open Market Intelligence local research; contact=you@example.com
US_MARKET_HTTP_TIMEOUT_SECONDS=30
JP_MARKET_HTTP_TIMEOUT_SECONDS=30
KR_MARKET_HTTP_TIMEOUT_SECONDS=30
# Japan fundamentals use J-Quants v2 summary. Prefer JQUANTS_API_KEY for local runs.
JQUANTS_API_BASE_URL=https://api.jquants.com/v2
JQUANTS_API_KEY=
# Legacy v1 token flow fallback. J-Quants v1 has been migrated to v2.
JQUANTS_ID_TOKEN=
JQUANTS_REFRESH_TOKEN=
JQUANTS_MAIL_ADDRESS=
JQUANTS_PASSWORD=
JQUANTS_ID_TOKEN_CACHE_SECONDS=82800
# Korea fundamentals use OpenDART. Leave key empty to skip KR fundamentals refresh visibly.
OPENDART_API_BASE_URL=https://opendart.fss.or.kr/api
OPENDART_API_KEY=
# Keep false for local desktop/dev runs unless a real outbound proxy is required.
OMI_HTTP_TRUST_ENV=false
OPENAI_API_KEY=
# Optional alias used by the desktop pet launcher. OMI uses it only if OPENAI_API_KEY is empty.
OPENAI_LLM_API_KEY=
# Optional external env file to read OPENAI_API_KEY / OPENAI_LLM_API_KEY from at runtime.
# OMI_OPENAI_ENV_FILE=C:/project/kuro/.env
OPENAI_MODEL=gpt-5.4-mini
OPENAI_RESPONSES_URL=https://api.openai.com/v1/responses
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_OUTPUT_TOKENS=1800
OMI_AI_ALLOW_LOCAL_TRUST=true
OMI_AI_TRUSTED_CLIENT_HOSTS=127.0.0.1,::1
# Optional token for trusted non-loopback AI report/debug tool access.
OMI_AI_TRUST_TOKEN=

# Scheduler
ENABLE_SCHEDULER=false
TIMEZONE=Asia/Taipei
SCHEDULER_MARKET_REFRESH_TIME=15:15
SCHEDULER_MARKET_REFRESH_LOOKBACK_DAYS=7
SCHEDULER_MARKET_REFRESH_SLEEP_SECONDS=0.2
SCHEDULER_MARKET_CHIP_REFRESH_TIME=15:10
SCHEDULER_MARKET_CHIP_MARGIN_REFRESH_TIME=21:10
SCHEDULER_MARKET_MARGIN_REFRESH_TIME=21:10
SCHEDULER_MARKET_CHIP_REFRESH_INDEX_IDS=TAIEX,TPEX
SCHEDULER_MARKET_CHIP_REFRESH_FORCE=false
# Independent lightweight collector. Polls only during Taiwan futures live sessions.
ENABLE_TAIWAN_FUTURES_SCHEDULER=true
SCHEDULER_TAIWAN_FUTURES_SYMBOLS=TXF,MXF,TMF
SCHEDULER_TAIWAN_FUTURES_SESSION=auto
SCHEDULER_TAIWAN_FUTURES_INTERVAL_SECONDS=30
SCHEDULER_TAIWAN_FUTURES_SUCCESS_EVENT_INTERVAL_SECONDS=300
ENABLE_US_MARKET_SCHEDULER=false
# Default assumes Asia/Taipei: run Tue-Sat morning after US regular sessions close.
SCHEDULER_US_MARKET_REFRESH_TIME=06:30
SCHEDULER_US_MARKET_REFRESH_DAY_OF_WEEK=tue-sat
SCHEDULER_US_MARKET_REFRESH_OUTPUTSIZE=compact
SCHEDULER_US_MARKET_REFRESH_ADJUSTED=false
SCHEDULER_US_MARKET_REFRESH_SLEEP_SECONDS=12.0
ENABLE_JP_MARKET_SCHEDULER=false
# Requires ENABLE_SCHEDULER=true. Default assumes Asia/Taipei: run after Japan regular session data is typically available.
SCHEDULER_JP_MARKET_REFRESH_TIME=16:10
SCHEDULER_JP_MARKET_REFRESH_DAY_OF_WEEK=mon-fri
SCHEDULER_JP_MARKET_REFRESH_OUTPUTSIZE=compact
SCHEDULER_JP_MARKET_REFRESH_PROVIDER=auto
SCHEDULER_JP_MARKET_REFRESH_INCLUDE_FUNDAMENTALS=true
SCHEDULER_JP_MARKET_REFRESH_SLEEP_SECONDS=15.0
ENABLE_KR_MARKET_SCHEDULER=false
# Requires ENABLE_SCHEDULER=true. Default assumes Asia/Taipei: run after Korea regular session data is typically available.
SCHEDULER_KR_MARKET_REFRESH_TIME=16:20
SCHEDULER_KR_MARKET_REFRESH_DAY_OF_WEEK=mon-fri
SCHEDULER_KR_MARKET_REFRESH_OUTPUTSIZE=compact
SCHEDULER_KR_MARKET_REFRESH_PROVIDER=auto
SCHEDULER_KR_MARKET_REFRESH_INCLUDE_FUNDAMENTALS=false
SCHEDULER_KR_MARKET_REFRESH_SLEEP_SECONDS=15.0
ENABLE_WATCHLIST_RADAR_SCHEDULER=true
# Daily radar snapshot and T+1 outcome evaluation. Empty group ids means all active watchlist groups.
SCHEDULER_WATCHLIST_RADAR_TIME=15:45
SCHEDULER_WATCHLIST_RADAR_DAY_OF_WEEK=mon-fri
SCHEDULER_WATCHLIST_RADAR_GROUP_IDS=
SCHEDULER_WATCHLIST_RADAR_MODES=action
SCHEDULER_WATCHLIST_RADAR_INCLUDE_CHILDREN=true
SCHEDULER_WATCHLIST_RADAR_ENABLED_ONLY=true
SCHEDULER_WATCHLIST_RADAR_MAX_RESULTS=30
SCHEDULER_WATCHLIST_RADAR_CALCULATION_LIMIT=100
SCHEDULER_WATCHLIST_RADAR_USE_INTRADAY=true
SCHEDULER_WATCHLIST_RADAR_INTRADAY_LIMIT=30
SCHEDULER_WATCHLIST_RADAR_EVALUATE_LOOKBACK_DAYS=10
SCHEDULER_WATCHLIST_RADAR_REQUIRE_DAILY_RELEASE=true
SCHEDULER_WATCHLIST_RADAR_RECONCILE_INTERVAL_MINUTES=30
SCHEDULER_WATCHLIST_RADAR_RECONCILE_UNTIL=18:15
ENABLE_DISPATCH_SCHEDULER=true
SCHEDULER_DISPATCH_TICK_INTERVAL_SECONDS=60

# Optional SMTP settings for Dispatch. Use app passwords or provider-specific
# SMTP credentials; never commit real credentials.
DISPATCH_SMTP_HOST=
DISPATCH_SMTP_PORT=587
DISPATCH_SMTP_USERNAME=
DISPATCH_SMTP_PASSWORD=
DISPATCH_SMTP_FROM_EMAIL=
DISPATCH_SMTP_FROM_NAME=Open Market Intelligence
DISPATCH_SMTP_USE_TLS=true
DISPATCH_SMTP_USE_SSL=false
DISPATCH_SMTP_TIMEOUT_SECONDS=30
